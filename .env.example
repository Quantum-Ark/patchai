# Neatlogs Observability
NEATLOGS_API_KEY=your_neatlogs_project_api_key_here

# LLM Providers (Configure at least one or use mock provider for testing)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: GitHub Access (for live issue fetching)
GITHUB_TOKEN=your_github_personal_access_token_here

# PatchPilot Settings
PATCHPILOT_MODEL=gpt-4o
PATCHPILOT_MAX_ATTEMPTS=3
PATCHPILOT_TIMEOUT_SECONDS=60
